# scripts/.env.production.example
# =============================================================================
# Calisthenics Tree — production environment template
# =============================================================================
#
# This file is a TEMPLATE. The real .env.production lives on the VPS at
# /root/calisthenicstree-secrets/.env (per the pattern in CAMERON-MEMORY's
# deploy-to-vps.sh notes — secrets are sourced from per-app secret files,
# not inlined in scripts).
#
# Workflow:
#   1. ssh root@187.77.26.99
#   2. Edit /root/calisthenicstree-secrets/.env from this template
#   3. /opt/calisthenicstree/scripts/deploy-to-vps.sh
#
# Generate fresh secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#   openssl rand -hex 32

# ---------------------------------------------------------------------
# Required: Database
# ---------------------------------------------------------------------
POSTGRES_USER=calisthenics
POSTGRES_PASSWORD=__REPLACE__generate_32_chars__
POSTGRES_DB=calisthenics

# ---------------------------------------------------------------------
# Required: Auth
# ---------------------------------------------------------------------
# Static bearer used by tests / Postman / CI. Generate fresh.
BEARER_TOKEN=__REPLACE__32_chars__
# JWT signing secret (PyJWT HS256). MUST differ from bearer.
JWT_SECRET=__REPLACE__64_chars_token_urlsafe__
# Magic-link token signing (itsdangerous). MUST differ from JWT_SECRET.
MAGIC_LINK_SECRET=__REPLACE__64_chars_token_urlsafe__

# ---------------------------------------------------------------------
# Required: Email
# ---------------------------------------------------------------------
# When set, magic-link emails go through Postmark.
# Get a server token at https://postmarkapp.com (free tier: 100 emails/mo).
POSTMARK_TOKEN=
POSTMARK_FROM_EMAIL=hello@calisthenics-tree.com

# ---------------------------------------------------------------------
# Required: Public URL
# ---------------------------------------------------------------------
# Used to build magic-link URLs in outgoing emails.
WEB_BASE_URL=https://calisthenics-tree.com

# ---------------------------------------------------------------------
# Optional: Error tracking (Sentry)
# ---------------------------------------------------------------------
# Create a FastAPI project at https://sentry.io, copy the DSN.
SENTRY_DSN=

# ---------------------------------------------------------------------
# Optional: Product analytics (PostHog Cloud)
# ---------------------------------------------------------------------
# Free tier: 1M events/mo. Get the API key from project settings.
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------
# Billing (P5 paywall scaffold)
# ---------------------------------------------------------------------
# Active payment provider. 'null' = no-op (checkout returns 503).
# Wire to 'stripe' (or 'storekit') once keys + webhook secret are set.
PAYMENT_PROVIDER=null
BILLING_WEBHOOK_SECRET=
PRICE_MONTHLY_CENTS=599
PRICE_YEARLY_CENTS=2999
PRICE_LIFETIME_CENTS=9900