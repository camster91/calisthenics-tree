# Caddy config for the Calisthenics Tree SPA.
#
# Two operating modes selected by env var:
#   - Local dev (CADDY_DOMAIN unset or set to ":80"):
#       plain HTTP on :80, no ACME. Caddy serves the static bundle
#       and reverse-proxies /api/* to the api container.
#   - Production (Traefik-fronted):
#       Traefik handles TLS termination on the VPS. Caddy just listens
#       on :80 internally (no TLS, no ACME) — Traefik labels on the
#       web service route workout.ashbi.ca → this container.
#
# In both modes:
#   - /api/*    → reverse-proxy to api:8000 (docker-network DNS)
#   - /share/*  → same (social-bot previews + share-card rasterization)
#   - /healthz  → static 200 (container healthcheck + uptime monitor)
#   - everything else → index.html (SPA fallback for client routing)
#
# IMPORTANT: the path-specific handles MUST come before the catch-all
# SPA fallback. Without `handle_path`, Caddy's try_files rewrite runs
# first and rewrites /api/* + /share/* + /healthz to /index.html
# (because the file doesn't exist) before the reverse_proxy / respond
# directives get a chance. handle_path creates an explicit named matcher
# that short-circuits the rewrite for those prefixes.

:80 {
    # API + share reverse-proxy — strip the prefix, forward rest to api
    handle_path /api/* {
        reverse_proxy api:8000
    }
    handle_path /share/* {
        reverse_proxy api:8000
    }

    # Container / orchestrator healthcheck — always 200, no auth, no rate-limit
    handle_path /healthz {
        respond 200
    }

    # SPA fallback for everything else: try the file, fall back to index.html
    # so React Router can take over client-side.
    root * /srv
    try_files {path} /index.html
    file_server
}