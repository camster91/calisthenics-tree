# Caddy config for the Calisthenics Tree SPA.
#
# Two operating modes selected by env var:
#   - Local dev (CADDY_DOMAIN unset or set to a bare port like ":80"):
#       plain HTTP on :80, no ACME. Caddy serves the static bundle
#       and reverse-proxies /api/* to the api container.
#   - Production (CADDY_DOMAIN=calisthenics-tree.com):
#       ACME-managed Let's Encrypt cert, strict TLS (TLS 1.2/1.3),
#       HSTS + X-Content-Type-Options + X-Frame-Options + Referrer-Policy
#       headers baked in.
#
# In both modes:
#   - /api/*    → reverse-proxy to api:8000 (docker-network DNS)
#   - /share/*  → same (social-bot previews + share-card rasterization)
#   - /healthz  → static 200 (container healthcheck + uptime monitor)
#   - everything else → index.html (SPA fallback for client routing)

{$CADDY_DOMAIN::80} {
    tls {$CADDY_EMAIL}

    encode zstd gzip

    # Container / orchestrator healthcheck — always 200, no auth, no rate-limit
    respond /healthz 200

    # API + share reverse-proxy. /api/* goes to FastAPI; /share/* is the
    # social-bot preview path that hits the same upstream.
    reverse_proxy /api/*    api:8000
    reverse_proxy /share/*  api:8000

    # SPA fallback — unknown routes get the index.html so React Router
    # can take over client-side.
    root * /srv
    try_files {path} /index.html
    file_server

    # Production-only: when a real domain is set, harden the response.
    @prod header_regexp host ^calisthenics-tree\.com$
    header @prod Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    header @prod X-Content-Type-Options "nosniff"
    header @prod X-Frame-Options "SAMEORIGIN"
    header @prod Referrer-Policy "strict-origin-when-cross-origin"

    tls {
        protocols tls1.2 tls1.3
    }
}