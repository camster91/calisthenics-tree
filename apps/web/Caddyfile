# Caddy config for the Calisthenics Tree SPA.
#
# - /api/*          → reverse-proxy to the api container on the docker network
# - /share/*        → same (used by social-bot previews of share cards)
# - /auth/verify    → SPA route, must hit index.html for client-side routing
# - /healthz        → static 200 for the container healthcheck
# - everything else → index.html (SPA fallback)
#
# In production, replace `:80` with the public hostname + enable the
# ACME email block so Caddy issues a Let's Encrypt cert.

:80 {
    # Container healthcheck
    respond /healthz 200

    # API + share reverse-proxy
    reverse_proxy /api/*    api:8000
    reverse_proxy /share/*  api:8000

    # SPA fallback — everything else goes to index.html for client routing
    root * /srv
    try_files {path} /index.html
    file_server
}

# Production example (uncomment + replace placeholder when going live):
#
# calisthenics-tree.com {
#     encode zstd gzip
