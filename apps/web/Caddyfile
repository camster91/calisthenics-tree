# Caddy config for the Calisthenics Tree SPA.
#
# Two operating modes selected by env var:
#   - Local dev (CADDY_DOMAIN unset or set to ":80"):
#       plain HTTP on :80, no ACME. Caddy serves the static bundle
#       and reverse-proxies /api/* to the api container.
#   - Production (Traefik-fronted):
#       Traefik handles TLS termination on the VPS. Caddy just listens
#       on :80 internally (no TLS, no ACME) — Traefik labels on the
#       web service route workout.ashbi.ca → this container.
#
# Path routing inside this container:
#   - /api/*        → reverse-proxy to api:8000
#   - /healthz      → reverse-proxy to api:8000 (real healthz payload;
#                     Docker's HEALTHCHECK still sees 200)
#   - /sitemap.xml  → reverse-proxy to api:8000 (Google / Bing discover
#                     the apex-domain sitemap here; the api has it at
#                     root mount via apps/api/calisthenics_api/main.py
#                     include_router(seo.router) — NOT under /api/v1)
#   - /robots.txt   → reverse-proxy to api:8000 (same seo module;
#                     Disallow rules for private routes)
#   - /share/<id>.png → static PNG from public/share/ (committed in Sprint 18)
#   - /share/<unlockId> → SPA fallback → ShareRenderPage React component
#   - everything else → SPA fallback → index.html
#
# IMPORTANT: each route is evaluated in declaration order, and the
# FIRST matching route handles the request. The catch-all SPA fallback
# MUST be the last route.

:80 {
    # Sprint 38 hardening YELLOW — security headers. Applied at the
    # server level so every response (API proxied + SPA fallback + static)
    # carries them. CSP is permissive for PostHog + Google Fonts; tighten
    # in Sprint 39 if you remove those dependencies.
    header {
        # HSTS — only effective when served over HTTPS (Traefik does TLS).
        # max-age=31536000 = 1y; includeSubDomains + preload ready for hstspreload.org.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Prevent MIME sniffing.
        X-Content-Type-Options "nosniff"
        # Don't allow iframe embedding.
        X-Frame-Options "DENY"
        # Referrer leakage — only send origin on cross-origin, full URL on same-origin.
        Referrer-Policy "strict-origin-when-cross-origin"
        # Disable unused powerful features.
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        # Content-Security-Policy. PostHog + Google Fonts explicitly
        # allowed. upgrade-insecure-requests forces HTTPS.
        #
        # Sprint 40: dropped BOTH 'unsafe-inline' (from script-src AND
        # style-src) AND 'unsafe-eval'. The production bundle has:
        #   - 0 eval() / new Function() calls (verified dist/assets/)
        #   - 0 inline <script> tags (vite emits only <script type=module src=...>)
        #   - 0 inline style="" attributes (Tailwind v4 builds classes into
        #     external .css files at build time)
        #   - 0 inline <style> blocks
        # The 'unsafe-inline' was only relevant for the dev-mode Vite
        # HMR client, never present in the pre-built image Caddy serves.
        # Browser auto-emits `style="display:none"` on the noscript
        # fallback if needed; we don't use a noscript on the SPA so
        # no nonce required.
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://us.i.posthog.com https://api.workout.ashbi.ca; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; report-uri /api/v1/_csp_report; upgrade-insecure-requests"
        # Cross-origin isolation (defense in depth; required for SharedArrayBuffer if we ever need it).
        Cross-Origin-Opener-Policy "same-origin"
        # Don't leak the full URL in Referer.
        -Server
    }

    # API reverse-proxy — forward /api/* to FastAPI
    route /api/* {
        reverse_proxy api:8000
    }

    # Health probe — proxy to the API so the response carries the real
    # {"status":"ok","version":...} payload. Docker's HEALTHCHECK just
    # looks at the status code (200) so the JSON body is fine for it too.
    route /healthz {
        reverse_proxy api:8000
    }

    # SEO endpoints — proxied to api so Google + Bing discover them
    # at the apex domain, not just at the api hostname. The api module
    # is mounted at root (not under /api/v1) for exactly this reason.
    # MUST come BEFORE the SPA fallback or index.html wins.
    route /sitemap.xml {
        reverse_proxy api:8000
    }
    route /robots.txt {
        reverse_proxy api:8000
    }

    # Sprint 38 RED-9 follow-up — gzip + cache headers for fingerprinted
    # assets. Vite emits hashed filenames (`index-CPp13brX.js`), so we
    # can set max-age=1y + immutable safely: a new deploy produces new
    # hashes, the old ones stay cached until they expire. Drops repeat
    # visitor bandwidth by ~70% (gzip 264KB → 70KB).
    route /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        encode zstd gzip
        root * /srv
        file_server
    }

    # /share/* intentionally falls through to the SPA fallback below.
    # Static PNGs committed to apps/web/public/share/ are served by
    # file_server (try_files finds them first); /share/<unlockId>
    # (no .png) hits the SPA fallback which routes to ShareRenderPage.

    # SPA fallback for everything else: try the file, fall back to index.html
    # so React Router can take over client-side.
    route {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}