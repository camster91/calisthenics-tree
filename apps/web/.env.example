# =============================================================================
# Calisthenics Tree — web app environment variables
# =============================================================================
# Copy this file to `.env.local` (gitignored) and fill in real values for local
# dev. Vite reads VITE_* vars at build time and exposes them via
# `import.meta.env.VITE_*` in source.
#
# All VITE_ vars are PUBLIC — they're bundled into the client JS. Never put a
# real secret here. The API token below is a dev-only bearer shared between
# the web client and FastAPI in docker-compose; Phase 2 replaces this with real
# auth (Apple Sign-In + email magic link, see docs/PLAN.md Gap 2).
# =============================================================================

# Base URL for the FastAPI backend.
#   - Local dev: leave unset → defaults to '/api/v1' in api.ts (Caddy in the
#     dev docker-compose proxies '/api/*' to the api on :8000)
#   - Remote dev/staging: set to the full URL, e.g. https://api.dev.workout.ashbi.ca
#   - Prod: set at build time in CI (e.g. https://api.workout.ashbi.ca)
# VITE_API_URL=http://localhost:8000

# Bearer token sent on every non-skipAuth API request.
# Matches BEARER_TOKEN in docker-compose.yml (apps/api env block).
# Replace per-environment. Never commit a real production token.
VITE_API_TOKEN=dev-bearer-token-replace-me

# -----------------------------------------------------------------------------
# PostHog Cloud analytics (Phase 2 — docs/PLAN.md Gap 4)
# -----------------------------------------------------------------------------
# Free 1M events/mo on PostHog Cloud (self-host deferred until 5M+ events/mo).
# Get your project API key from https://us.i.posthog.com (or eu.i.posthog.com).
#
# Leave VITE_POSTHOG_API_KEY UNSET in dev / preview envs to disable analytics
# entirely — initAnalytics() short-circuits and every capture* becomes a no-op.
# This keeps local dev noise-free and avoids leaking dev traffic into prod
# dashboards.
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com