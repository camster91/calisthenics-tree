# =============================================================================
# Calisthenics Tree — API service environment variables
# =============================================================================
# Copy this file to `.env` and replace placeholder values before running locally.
# `.env` is gitignored (see root .gitignore). Never commit real secrets.
#
# Phase notes:
#   Phase 1  — backend + schema (current). Only vars under "Database", "Auth"
#              (BEARER_TOKEN), and "App" are read by config.py today.
#   Phase 2+ — web SPA, auth flows, analytics, observability. Vars marked
#              "Phase 2+" or "Phase 4+" are documented early so the surface
#              is stable; they are NOT yet consumed by config.py.
#              See docs/PLAN.md Gap 2 (auth), Gap 4 (analytics), and the
#              "Deploy, infra, ops" section (line ~244) for context.
# =============================================================================


# --- Database ---------------------------------------------------------------
# Async SQLAlchemy URL consumed by `config.py:Settings.database_url`.
# Default (if unset) matches docker-compose.yml's `db` service on port 5433.
#   Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
# Local dev (docker compose):     use host `db` and port `5432` (in-network).
# Local dev (host runs Postgres): use host `localhost` and port `5433`.
# Production: use a strong password + secret URL injected by Coolify, NOT this file.
DATABASE_URL=postgresql+asyncpg://calisthenics:change-me-in-production@localhost:5433/calisthenics


# --- Auth -------------------------------------------------------------------
# Shared bearer token required on every route except /healthz.
# Consumed by `config.py:Settings.bearer_token`.
# Dev default is `dev-bearer-token-replace-me`; production MUST override.
# Phase 1 only uses this static token. Phase 2+ replaces it with JWTs
# (see JWT_SECRET below).
BEARER_TOKEN=dev-bearer-token-replace-me

# Phase 2+ — JWT signing secret for access + refresh tokens (issued after
# Apple Sign-In or magic-link verification). Required once auth flows land.
# Generate with: `python -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT_SECRET=change-me-in-production-use-secrets-token-urlsafe-64

# Phase 2+ — Secret used to sign/hmac magic-link tokens sent by email.
# Same generation rule as JWT_SECRET. Must differ from JWT_SECRET.
MAGIC_LINK_SECRET=change-me-in-production-use-secrets-token-urlsafe-64

# Phase 2+ — Postmark transactional email token (used to deliver magic links
# to web/Android users). PLAN.md Gap 2 — ~$15/mo at 10K users.
# Get a server token at https://postmarkapp.com (free tier: 100 emails/mo).
POSTMARK_TOKEN=change-me-in-production-postmark-server-token

# Phase 2+ — Apple Sign-In credentials (iOS clients send identity JWTs here).
#   APPLE_CLIENT_ID = the Service ID or App ID registered in Apple Developer.
#   APPLE_TEAM_ID   = your 10-char Apple Developer Team ID.
# Both verified server-side against Apple's JWKS during sign-in.
APPLE_CLIENT_ID=com.ashbi.calisthenicstree.web
APPLE_TEAM_ID=ABCDE12345


# --- App --------------------------------------------------------------------
# Current environment name. Consumed by `config.py:Settings.environment`.
# Common values: `development`, `staging`, `production`.
ENVIRONMENT=development

# API URL prefix. Consumed by `config.py:Settings.api_v1_prefix`.
# Almost always leave at the default. Override only if mounting under a subpath.
API_V1_PREFIX=/api/v1


# --- Analytics (Phase 2+) ---------------------------------------------------
# PostHog Cloud project API key. Wire in during Phase 2 per PLAN.md Gap 4.
# Free tier covers 1M events/mo; self-host deferred until 5M+ events/mo.
POSTHOG_API_KEY=phc_change_me_in_production

# PostHog host. Use the US Cloud default unless you're on EU Cloud
# (https://eu.i.posthog.com).
POSTHOG_HOST=https://us.i.posthog.com


# --- Observability (Phase 2+) -----------------------------------------------
# Sentry DSN for FastAPI error reporting. Free tier per PLAN.md ops section.
# Leave blank in dev to disable Sentry entirely (SDK should no-op on empty DSN).
SENTRY_DSN=

# Sentry environment tag (mirrors `ENVIRONMENT` but kept separate so you can
# run multiple Sentry projects per env if needed).
SENTRY_ENVIRONMENT=development

# Fraction of transactions to capture for performance monitoring (0.0 – 1.0).
# Keep low (<= 0.1) on free tier; Sentry counts traces against event quota.
SENTRY_TRACES_SAMPLE_RATE=0.0


# --- Share cards (Phase 1.5) ------------------------------------------------
# Directory containing pre-rendered share card PNGs (T39).
# Relative to apps/api/ working directory, or absolute.
# Production: render via `cd apps/web && npm run share:render` as a
# deploy step, then mount the rendered directory here.
SHARE_DIR=../web/public/share


# --- Phase 4+ (Native shell, document-only) ---------------------------------
# Reserved for Capacitor / HealthKit / push-notification work in Phase 4.
# Not consumed by config.py; included here so the env-file shape is stable
# before the native shell lands. See PLAN.md Phase 4 (Weeks 12-20).
# HEALTHKIT_BUNDLE_ID=com.ashbi.calisthenicstree
# APNS_KEY_ID=change-me-in-production
# APNS_TEAM_ID=ABCDE12345
# APNS_KEY_PATH=/run/secrets/apns_auth_key.p8